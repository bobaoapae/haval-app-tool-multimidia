<?xml version="1.0" encoding="utf-8"?>
<!-- Emulator-flavor manifest: declares AAOS Car API permissions required by
     EmulatorVehicleBridge to access VHAL properties via CarPropertyManager.
     These permissions are intentionally absent from the production flavor. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Signature-level guard for the ADB steering-wheel key broadcast.
         Only apps signed with the same key (or the shell via adb) can send it. -->
    <permission
        android:name="br.com.redesurftank.havalshisuku.EMULATOR_BROADCAST"
        android:protectionLevel="signature" />
    <uses-permission android:name="br.com.redesurftank.havalshisuku.EMULATOR_BROADCAST" />

    <uses-permission android:name="android.car.permission.CAR_SPEED" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.car.permission.CAR_ENGINE_DETAILED" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.car.permission.CAR_INFO" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" tools:ignore="ProtectedPermissions" />

</manifest>
