<theme>
    <name>Minimalist</name>
    <description>Clean, square edges, flat menu, and minimalist typography.</description>
    <version>1.3.7</version>
    <minBridgeVersion>1.1.9</minBridgeVersion>
    <thumbnail>thumbnail.png</thumbnail>
    <mainFile>app.html</mainFile>
    <!-- Cluster Display-1 wallpaper shipped with the theme (used when bg mode = THEME).
         Pre-baked at 1920x720 with the .mask-panel L/R gradients burned in, so the
         "integrated" edges survive on card 0 where the display-3 masks must be hidden.
         Regenerate with: python scripts/bake-cluster-bg.py -->
    <background>car-bg.png</background>
    <AppDefaultPosition>
        <x>0</x>
        <y>62</y>
        <width>1920</width>
        <height>596</height>
    </AppDefaultPosition>
</theme>
