<theme>
    <name>Minimalist</name>
    <description>Clean, square edges, flat menu, and minimalist typography.</description>
    <version>1.6.0</version>
    <minBridgeVersion>1.0.0</minBridgeVersion>
    <contractVersion>v1.0</contractVersion>
    <thumbnail>thumbnail.png</thumbnail>
    <mainFile>app.html</mainFile>
    <!-- Cluster Display-1 wallpaper shipped with the theme (used when bg mode = THEME).
         Pre-baked at 1920x720 with the .mask-panel L/R gradients burned in, so the
         "integrated" edges survive on card 0 where the display-3 masks must be hidden.
         Regenerate with: python scripts/bake-cluster-bg.py -->
    <background>car-bg.png</background>
    <AppDefaultPosition>
        <x>0</x>
        <y>62</y>
        <width>1920</width>
        <height>596</height>
    </AppDefaultPosition>

    <!-- Native cluster mask overlays rendered on Display 3 by Android host -->
    <nativeMasks>
        <fuelMask enabled="true" x="0" y="653" width="730" height="67" />
        <batteryMask enabled="true" x="1190" y="653" width="730" height="67" />
        <topCenterMask enabled="true" x="710" y="0" width="500" height="67" />
        <!-- <speedMask enabled="false" x="0" y="0" width="600" height="720" /> -->
        <!-- <infoMask enabled="false" x="1320" y="0" width="600" height="720" /> -->
    </nativeMasks>

    <configurations>
        <configuration>
            <id>show_regen_icon</id>
            <label>Exibir Indicador de Regen</label>
            <type>boolean</type>
            <default>true</default>
            <stateVariable>showRegenIcon</stateVariable>
        </configuration>
        <configuration>
            <id>show_rpm_icon</id>
            <label>Exibir Indicador de RPM</label>
            <type>boolean</type>
            <default>true</default>
            <stateVariable>showRpmIcon</stateVariable>
        </configuration>
        <configuration>
            <id>navigation_display_mode</id>
            <label>Modo de Exibição na Navegação</label>
            <type>combo</type>
            <options>Padrão, Reduzido, Clean</options>
            <default>Clean</default>
            <stateVariable>navigationDisplayMode</stateVariable>
        </configuration>
        <configuration>
            <id>app_display_mode</id>
            <label>Modo de Exibição de Outros Apps</label>
            <type>combo</type>
            <options>Padrão, Reduzido, Clean</options>
            <default>Padrão</default>
            <stateVariable>appDisplayMode</stateVariable>
        </configuration>
        <configuration>
            <id>top_bar_visibility</id>
            <label>Exibir Barra Superior</label>
            <type>combo</type>
            <options>Sempre, Só com Projeção, Só sem Projeção, Nunca</options>
            <default>Sempre</default>
            <stateVariable>topBarVisibility</stateVariable>
        </configuration>
        <configuration>
            <id>bottom_bar_visibility</id>
            <label>Exibir Barra Inferior</label>
            <type>combo</type>
            <options>Sempre, Só com Projeção, Só sem Projeção, Nunca</options>
            <default>Só com Projeção</default>
            <stateVariable>bottomBarVisibility</stateVariable>
        </configuration>
        <configuration>
            <id>bottom_bar_notch</id>
            <label>Recorte da Barra Inferior</label>
            <type>boolean</type>
            <default>true</default>
            <stateVariable>bottomBarNotch</stateVariable>
        </configuration>
        <!-- Multiple selection, stored as a comma separated list. On app builds that do
             not know the "multi" type the settings dialog shows the label with no
             control and the theme keeps this default, so the theme stays usable. -->
        <configuration>
            <id>projection_keep_visible</id>
            <label>Manter Visível na Projeção</label>
            <type>multi</type>
            <options>Gauges, Hora, Marcha, HEV, Regen</options>
            <default>Gauges, Hora, Marcha, HEV, Regen</default>
            <stateVariable>projectionKeepVisible</stateVariable>
        </configuration>
    </configurations>
</theme>
