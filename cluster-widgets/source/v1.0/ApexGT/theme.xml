<theme>
    <name>Apex GT</name>
    <description>Contour e Vector: dois displays Apex GT com instrumentos dinâmicos, menus do veículo, centro transparente para o ADAS nativo, velocidade calibrada como o HUD e projeção integrada ao mapa.</description>
    <version>1.0.17</version>
    <thumbnail>thumbnail.png</thumbnail>
    <mainFile>app.html</mainFile>
    <decentralized>true</decentralized>
    <minBridgeVersion>1.0.1</minBridgeVersion>
    <contractVersion>v1.0</contractVersion>
    <!--
      App rect on the cluster (the Android Auto map window and apps sent to D1/D3), one per
      "Projeção no painel" mode. apex-projection.js reads these with getThemeDisplayModes() and
      applies the active one with setAppDefaultDimensions().
      Ampla: full panel, so the map reaches every edge. Janela: the transparent #adas-viewport.
    -->
    <DisplayModes>
        <DisplayMode name="Ampla" x="0" y="0" width="1920" height="720"/>
        <DisplayMode name="Janela" x="520" y="120" width="880" height="530"/>
    </DisplayModes>
    <configurations>
        <configuration>
            <id>apex_display_mode</id>
            <label>Display</label>
            <type>combo</type>
            <options>Contour, Vector</options>
            <default>Contour</default>
            <stateVariable>apexDisplayMode</stateVariable>
            <group>Exibição</group>
        </configuration>
        <configuration>
            <id>apex_projection_mode</id>
            <label>Projeção no painel (CarPlay / Android Auto)</label>
            <type>combo</type>
            <options>Ampla, Janela</options>
            <default>Ampla</default>
            <stateVariable>apexProjectionMode</stateVariable>
            <group>Exibição</group>
        </configuration>
    </configurations>
</theme>
