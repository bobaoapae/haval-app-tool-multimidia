{
  "name": "haval-minimalist",
  "private": true,
  "version": "1.0.0",
  "browserslist": [
    "last 3 versions",
    "not dead",
    "chrome 80",
    "android >= 9"
  ],
  "scripts": {
    "dev": "vite --port 1234",
    "dev-parcel": "parcel index.html",
    "dev-controls": "npm run dev",
    "clear": "rimraf dist .parcel-cache",
    "build": "npm run clear && parcel build index.html --dist-dir dist --public-url ./ --no-source-maps && node inline.js",
    "prerelease": "npm run build"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.11",
    "parcel": "^2.16.4",
    "rimraf": "^6.0.1",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-streaming": "^2.0.0",
    "date-fns": "^3.6.0"
  }
}
